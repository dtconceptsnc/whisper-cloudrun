# Cloud Run GPU-enabled Whisper API with NVIDIA L4 support
FROM nvidia/cuda:12.2.0-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV WHISPER_DIR=/app/whisper.cpp
ENV MODELS_DIR=/app/models
ENV PORT=8080
# Default model path (can override with -e WHISPER_MODEL=...)
ENV WHISPER_MODEL=${MODELS_DIR}/ggml-base.en.bin
# Optional: model URL to fetch at container start if model file is missing
ENV WHISPER_MODEL_URL=https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-base.en.bin

# System deps (ffmpeg for decoding, build tools for whisper.cpp, python for API)
RUN apt-get update && apt-get install -y \
    git build-essential cmake ffmpeg wget ca-certificates python3 python3-pip curl \
 && rm -rf /var/lib/apt/lists/*

# Build whisper.cpp with CUDA support for NVIDIA L4
# Use CUDA stub libraries for linking (actual drivers only available at runtime)
RUN git clone --depth=1 https://github.com/ggerganov/whisper.cpp.git ${WHISPER_DIR} \
 && cd ${WHISPER_DIR} \
 && export LD_LIBRARY_PATH=/usr/local/cuda/lib64/stubs:$LD_LIBRARY_PATH \
 && ln -s /usr/local/cuda/lib64/stubs/libcuda.so /usr/local/cuda/lib64/stubs/libcuda.so.1 \
 && cmake -B build \
    -DCMAKE_BUILD_TYPE=Release \
    -DGGML_CUDA=ON \
    -DCMAKE_CUDA_ARCHITECTURES=89 \
    -DGGML_CUDA_FORCE_MMQ=ON \
    -DCMAKE_LIBRARY_PATH=/usr/local/cuda/lib64/stubs \
 && cmake --build build --config Release --target whisper-cli -j$(nproc) \
 && rm /usr/local/cuda/lib64/stubs/libcuda.so.1

# App files
WORKDIR /app
COPY server.py /app/server.py
COPY entrypoint.sh /app/entrypoint.sh

# Copy pre-downloaded models if models/ directory exists with .bin files
# (Create an empty models/ directory if you don't have models to avoid build error)
COPY models/ ${MODELS_DIR}/

RUN chmod +x /app/entrypoint.sh \
 && pip3 install --no-cache-dir fastapi uvicorn[standard] python-multipart requests

# Run as non-root for Cloud Run best practice
RUN useradd -m appuser \
 && mkdir -p ${MODELS_DIR} /tmp \
 && chown -R appuser:appuser /app /tmp
USER appuser

# Cloud Run uses $PORT
EXPOSE 8080
CMD ["/app/entrypoint.sh"]
